
# Configuración básica
set terminal wxt enhanced font 'Arial,10' size 1200,600
set title "Trayectoria "
set xlabel "Este Oeste"
set ylabel "Norte Sur"
set grid
set key outside right

set size ratio -1

# Graficar ambas columnas con líneas
plot "trayecto3.txt" using 3:4 with lines lw 2 lc rgb "red" title "Trayectoria"

pause -1 "Presiona Enter para salir"
